---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';
import Play from '../icons/Play.astro';
import FormattedDate from './FormattedDate.astro';
import { getMediaCardCapabilities } from '../utils/media-utils';

type Props = { media: CollectionEntry<'media'>; class?: string; headingLevel?: 'h2' | 'h3' | 'h4' };

const { media, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description, date, venue, type, url, topics, audience, image, imageAlt, video } =
  media.data;
const TitleTag = headingLevel;

// Format the media type for display
const typeLabels: Record<string, string> = {
  talk: 'Talk',
  podcast: 'Podcast',
  interview: 'Interview',
  workshop: 'Workshop',
  panel: 'Panel',
};

const capabilities = getMediaCardCapabilities({ url, video });
const playerId = `media-player-${media.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
---

<div
  class:list={[
    'media-card-interactive border-main border-l-accent-main bg-background block rounded-lg border border-l-4 p-6 transition-colors duration-200',
    className,
  ]}
>
  <div class="w-full">
    <TitleTag class="font-serif text-xl leading-tight font-medium sm:text-2xl">
      {
        capabilities.hasUrl ? (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent-main transition-colors hover:underline hover:decoration-dashed hover:decoration-1 hover:underline-offset-4"
          >
            {title}
          </a>
        ) : (
          <span>{title}</span>
        )
      }
    </TitleTag>

    <div class="mt-1 text-sm leading-normal text-neutral-600 dark:text-neutral-400">
      <span class="font-medium">{typeLabels[type] || type}</span> at{' '}
      <span class="font-medium">{venue}</span> • <FormattedDate date={date} />
    </div>

    {description && <div class="mt-3 text-sm leading-normal">{description}</div>}

    {image && <img src={image} alt={imageAlt ?? ''} class="mt-4 w-full rounded" />}

    {
      topics && topics.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1">
          {topics.map((topic) => (
            <span class="inline-block rounded-full bg-neutral-100 px-2 py-1 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
              {topic}
            </span>
          ))}
        </div>
      )
    }

    {
      audience && (
        <div class="mt-2 text-xs text-neutral-500 dark:text-neutral-500">Audience: {audience}</div>
      )
    }

    {/* Interactive Action Bar (Watch Clip / View External Link) */}
    {
      (capabilities.hasVideo || capabilities.hasUrl) && (
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-100 pt-2 dark:border-neutral-800/80">
          {capabilities.hasVideo ? (
            <button
              type="button"
              class="media-video-toggle inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-neutral-300 bg-neutral-100 px-3 py-1.5 text-xs font-medium text-neutral-800 transition-colors hover:bg-neutral-200 sm:text-sm dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700"
              data-embed-url={capabilities.embedUrl}
              data-video-label={capabilities.videoLabel}
              aria-expanded="false"
              aria-controls={playerId}
            >
              <Play class="text-accent-main h-3 w-3 fill-current" />
              <span class="btn-text">{capabilities.videoLabel}</span>
            </button>
          ) : (
            <div />
          )}

          {capabilities.hasUrl && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent-main hover:text-accent-hover inline-flex items-center gap-1 font-serif text-sm italic transition-colors"
            >
              View {typeLabels[type] || 'Link'}
              <ArrowRight class="h-4 w-4 fill-current" />
            </a>
          )}
        </div>
      )
    }

    {/* Expandable Video Container */}
    {
      capabilities.hasVideo && (
        <div
          id={playerId}
          class="media-video-container mt-4 hidden overflow-hidden rounded-lg border border-neutral-200 bg-neutral-950 dark:border-neutral-800"
          aria-hidden="true"
        >
          <div class="relative aspect-video w-full">
            <div class="video-iframe-slot h-full w-full" />
          </div>
        </div>
      )
    }
  </div>
</div>

<script>
  function setupMediaVideoPlayers() {
    const cards = document.querySelectorAll('.media-card-interactive');
    cards.forEach((card) => {
      if ((card as HTMLElement).dataset.playerInitialized === 'true') return;
      (card as HTMLElement).dataset.playerInitialized = 'true';

      const toggleBtn = card.querySelector('.media-video-toggle') as HTMLButtonElement | null;
      const container = card.querySelector('.media-video-container') as HTMLElement | null;
      const slot = card.querySelector('.video-iframe-slot') as HTMLElement | null;

      if (!toggleBtn || !container || !slot) return;

      const embedUrl = toggleBtn.dataset.embedUrl;
      const originalLabel = toggleBtn.dataset.videoLabel || 'Watch Clip';
      const labelSpan = toggleBtn.querySelector('.btn-text');

      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          toggleBtn.setAttribute('aria-expanded', 'false');
          container.setAttribute('aria-hidden', 'true');
          container.classList.add('hidden');
          if (labelSpan) labelSpan.textContent = originalLabel;
          slot.innerHTML = '';
        } else {
          toggleBtn.setAttribute('aria-expanded', 'true');
          container.setAttribute('aria-hidden', 'false');
          container.classList.remove('hidden');
          if (labelSpan) labelSpan.textContent = 'Hide Video';
          if (embedUrl) {
            slot.innerHTML = `<iframe src="${embedUrl}" title="Video player" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMediaVideoPlayers);
  } else {
    setupMediaVideoPlayers();
  }

  document.addEventListener('astro:page-load', setupMediaVideoPlayers);
</script>
